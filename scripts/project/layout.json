{
  "schema_version": 1,
  "development_tools": {
    "root": "tools",
    "installations": {
      "cloudflare_shop_stats": {
        "path": "cloudflare/shop-stats",
        "manifest": "scripts/cloudflare/shop_stats/package.json",
        "lock": "scripts/cloudflare/shop_stats/package-lock.json",
        "entry": "node_modules/wrangler/bin/wrangler.js"
      },
      "innosetup": {
        "path": "innosetup",
        "version": "6.7.3",
        "entry": "6.7.3/ISCC.exe"
      },
      "nuitka_gcc": {
        "path": "cache/nuitka/downloads/gcc/x86_64/15.2.0posix-13.0.0-msvcrt-r6/mingw64",
        "version": "15.2.0",
        "distribution": "WinLibs MinGW-w64 13.0.0 MSVCRT POSIX SEH r6",
        "entry": "bin/gcc.exe"
      }
    },
    "caches": {"npm": "cache/npm", "nuitka": "cache/nuitka"},
    "states": {"cloudflare": "state/cloudflare", "tool_paths": "state/tool-paths.json"}
  },
  "features": [
    "shop",
    "penguin",
    "chaos",
    "common",
    "platform",
    "ui"
  ],
  "artifact_categories": [
    "tasks",
    "releases",
    "git",
    "maintenance",
    "archive",
    "template-candidates",
    "template-registration"
  ],
  "registration_transaction_files": [
    "journal.json",
    "record.old",
    "record.new",
    "template.old",
    "template.new",
    "manifest.old",
    "manifest.new",
    "obsolete_template.old"
  ],
  "task_sections": [
    "inputs",
    "previews",
    "results",
    "scratch"
  ],
  "archive_categories": [
    "snapshots",
    "backups",
    "legacy"
  ],
  "docs_sections": [
    "user",
    "design",
    "development",
    "validation",
    "releases",
    "calibration"
  ],
  "test_sections": [
    "core",
    "vision",
    "resources",
    "platform",
    "logging",
    "automation",
    "ui",
    "scripts",
    "helpers",
    "fixtures"
  ],
  "test_script_sections": [
    "calibration",
    "validation",
    "release",
    "templates",
    "project",
    "cloudflare"
  ],
  "tool_test_extensions": {
    "cloudflare": [".py", ".md", ".mjs"]
  },
  "build_sections": [
    "nuitka",
    "staging"
  ],
  "calibration_records": {
    "client_calibration_manifest.yaml": "shop/client_calibration_manifest.yaml",
    "insufficient_funds_live_validation_manifest.yaml": "shop/insufficient_funds_live_validation_manifest.yaml",
    "insufficient_funds_manifest.yaml": "shop/insufficient_funds_manifest.yaml",
    "main_shop_icon_manifest.yaml": "shop/main_shop_icon_manifest.yaml",
    "main_shop_layout_manifest.yaml": "shop/main_shop_layout_manifest.yaml",
    "manifest.yaml": "shop/manifest.yaml",
    "purchased_button_manifest.json": "shop/purchased_button_manifest.json",
    "refresh_confirm_manifest.yaml": "shop/refresh_confirm_manifest.yaml",
    "shop_exit_icon_manifest.yaml": "shop/shop_exit_icon_manifest.yaml",
    "shop_refresh_button_manifest.yaml": "shop/shop_refresh_button_manifest.yaml",
    "sky_stone_manifest.yaml": "shop/sky_stone_manifest.yaml",
    "sky_stone_zero_wide_manifest.yaml": "shop/sky_stone_zero_wide_manifest.yaml",
    "sanctuary_search_manifest.json": "penguin/sanctuary_search_manifest.json",
    "overlay_position_calibration_manifest.yaml": "platform/overlay_position_calibration_manifest.yaml"
  },
  "source_rules": {
    "layers": [
      "core",
      "runtime",
      "features",
      "vision",
      "resources",
      "configuration",
      "platform",
      "logging",
      "ui"
    ],
    "root_modules": [
      "e7auto",
      "e7auto.__main__",
      "e7auto.app",
      "e7auto.bootstrap"
    ],
    "compatibility_modules": [],
    "legacy_modules": [
      "e7auto.automation",
      "e7auto.automation.dependencies",
      "e7auto.automation.engine",
      "e7auto.automation.penguin",
      "e7auto.automation.scrolling",
      "e7auto.automation.session",
      "e7auto.automation.snapshots",
      "e7auto.automation.stop_control",
      "e7auto.background_windows",
      "e7auto.config",
      "e7auto.domain",
      "e7auto.geometry",
      "e7auto.overlay_position",
      "e7auto.penguin_vision",
      "e7auto.platform_windows",
      "e7auto.ports",
      "e7auto.run_logging",
      "e7auto.template_manifest",
      "e7auto.vision_types",
      "e7auto.wgc_capture"
    ],
    "deferred_wgc_imports": {
      "e7auto.bootstrap": [
        "create_production_session"
      ],
      "e7auto.app": [
        "validate_wgc_import"
      ]
    }
  }
}
